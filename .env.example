# Copy this file to `.env` and set your values:
#   cp .env.example .env
#
# 実際のトークン・パスワード・シークレットは絶対にコミットしないでください。
# Cloudflare / Lovable デプロイ時も同じキー名で環境変数を設定してください。

# ==========================================
# Authentication
# ==========================================

# 平文パスワードは .env に保存しないこと。
# 以下のハッシュは `node scripts/hash-access-password.mjs` で対話入力して生成する。
# （アプリ共通パスワード → APP_ACCESS_PASSWORD_HASH、社員専用 → EMPLOYEE_ACCESS_PASSWORD_HASH）
# ハッシュに $ が含まれるため、値はそのまま貼り付けてください（開発時は .env を直接読み込みます）。
APP_ACCESS_PASSWORD_HASH=
EMPLOYEE_ACCESS_PASSWORD_HASH=

# Cookie 署名用シークレット（例: `openssl rand -base64 32` で生成）
SESSION_SECRET=

# 認証バージョン。値を変更すると既存セッションを一括失効できる
APP_AUTH_VERSION=
EMPLOYEE_AUTH_VERSION=

# ==========================================
# Notion
# ==========================================

# Notion Internal Integration Secret
# https://www.notion.so/my-integrations で作成
NOTION_TOKEN=

# ルートページ ID（URL の 32 文字 hex）。組織図・about など子ページの親
NOTION_PAGE_ID=

# 業務マニュアル DB ID（Q&A もこの DB の本文から抽出）
NOTION_MANUAL_DATABASE_ID=

# 社員業務 DB ID（Notion のデータベース URL または 32 文字 ID）
# 例: node scripts/set-notion-employee-work-database-id.mjs 'https://www.notion.so/...'
NOTION_EMPLOYEE_WORK_DATABASE_ID=

# カクテルレシピ DB ID
NOTION_COCKTAIL_DATABASE_ID=

# 現在未使用（専用 Q&A DB を使う場合の予備）
NOTION_QA_DATABASE_ID=

# ==========================================
# Application
# ==========================================

# development: ローカル開発 / production: 本番（Cookie Secure などに影響）
NODE_ENV=
